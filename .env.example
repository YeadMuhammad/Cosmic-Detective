# Server-side Netlify function and SPHEREx worker configuration.
# Copy to .env for local Netlify Dev and worker runs. Never commit real values.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
RATE_LIMIT_SALT=replace-with-a-random-local-value

# Optional worker settings
SPHEREX_BUCKET=spherex-products
WORKER_POLL_SECONDS=5
WORKER_ID=cosmic-detective-local
